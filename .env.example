# Copy this file to .env and fill in the values. Never commit .env.

# --- Telegram: token from @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- Google Cloud ---
# Project ID (not the name), e.g. lecturebot-471203
GOOGLE_CLOUD_PROJECT=
# Region for Gemini: "global" or e.g. "us-central1"
GOOGLE_CLOUD_LOCATION=global
# Bucket for temporary audio, e.g. lecturebot-audio-lecturebot-471203
GCS_BUCKET=

# --- Gemini ---
# "vertex"   = Gemini on Google Cloud (Agent Platform / Vertex AI), paid from trial credits
# "aistudio" = Gemini Developer API with a key from https://aistudio.google.com
GEMINI_BACKEND=vertex
# Check the current model ID in the Model Garden
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Key from https://aistudio.google.com. Required for GEMINI_BACKEND=aistudio.
# With GEMINI_BACKEND=vertex it is used only for YouTube links (Vertex AI can't open them).
GEMINI_API_KEY=

# --- YouTube Data API v3 (optional: without it YouTube links are disabled) ---
YOUTUBE_API_KEY=

# --- Speech-to-Text ---
SPEECH_LANGUAGE=uk-UA
# Up to 3 extra languages, comma separated
SPEECH_ALT_LANGUAGES=en-US

# --- Output and limits ---
OUTPUT_LANGUAGE=українська
QUIZ_QUESTIONS=5
MAX_AUDIO_MINUTES=90
YOUTUBE_MAX_MINUTES=60

# --- Webhook mode (Cloud Run only). Leave empty to run locally with polling. ---
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080
